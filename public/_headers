# Cloudflare Pages Headers
# Cache static assets aggressively
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*.wasm
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: application/wasm
  Access-Control-Allow-Origin: *
  Cross-Origin-Resource-Policy: cross-origin

/assets/*.js
  Content-Type: application/javascript; charset=utf-8

/draco/*
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: application/javascript; charset=utf-8

/basis/*
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: application/javascript; charset=utf-8

/public/*
  Cache-Control: public, max-age=86400

# Security headers - relaxed for WASM/Web Worker compatibility
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  # Permissions-Policy removed to allow WASM/Web Worker features

# CORS for WASM - allow cross-origin for worker loading
/*.wasm
  Access-Control-Allow-Origin: *
  Cross-Origin-Resource-Policy: cross-origin
  # COEP/COOP removed - they break Web Worker + WASM module loading